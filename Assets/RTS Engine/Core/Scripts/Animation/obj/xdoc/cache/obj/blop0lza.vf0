        startLine: 1485
      summary: "\nGet the appropriate stopping distance for an attack depending on the target type.\n"
      example: []
      syntax:
        content:
          CSharp: public float GetStoppingDistance(IEntity target, bool min = true)
          VB: Public Function GetStoppingDistance(target As IEntity, min As Boolean = True) As Single
        parameters:
        - id: target
          type: IEntity
          description: FactionEntity instance that represents the potential target for the unit.
        - id: min
          type: System.Boolean
          description: True to get the minimum value of the stopping range and false to get the maximum value of the stopping range.
        return:
          type: System.Single
          description: Stopping distance for the unit&apos;s movement to launch an attack.

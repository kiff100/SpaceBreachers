      source:
        id: IsPositionReserved
        path: ''
        startLine: 21067
      summary: "\nChecks whether a given position is reserved by a unit&apos;s target position marker or not.\n"
      example: []
      syntax:
        content:
          CSharp: public ErrorMessage IsPositionReserved(Vector3 testPosition, float radius, IEnumerable<TerrainAreaType> terrainAreas, bool playerCommand)
          VB: Public Function IsPositionReserved(testPosition As Vector3, radius As Single, terrainAreas As IEnumerable(Of TerrainAreaType), playerCommand As Boolean) As ErrorMessage
        parameters:
        - id: testPosition
          type: Vector3
        - id: radius
          type: System.Single
          description: The free radius required around the position in order to claim the position as not reserved.
        - id: terrainAreas
          type: System.Collections.Generic.IEnumerable{TerrainAreaType}
        - id: playerCommand
          type: System.Boolean
        return:
          type: RTSEngine.ErrorMessage
          description: ErrorMessage.none if the position is not reserved by a target position marker, otherwise either failure&apos;s error code in case of failure to check or ErrorMessage.positionReserved in case the position is reserved.

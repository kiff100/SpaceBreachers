        VB: RTSEngine.Search.GridSearchHandler.SearchRect(Of T)(Vector2, Vector2, System.Func(Of T, System.Boolean), ByRef System.Collections.Generic.List(Of T))
      type: Method
      assemblies:
      - cs.temp.dll
      namespace: RTSEngine.Search
      source:
        id: SearchRect
        path: ''
        startLine: 20826
      summary: "\nSearch for entities inside a rect defined by a lower left and upper right corner (in terms of world position on the X and Z coordinates) that statisfy a filter.\n"
      example: []
      syntax:
        content:
          CSharp: >-
            public ErrorMessage SearchRect<T>(Vector2 lowerLeftCorner, Vector2 upperRightCorner, Func<T, bool> filter, out List<T> resultList)

                where T : IEntity
          VB: Public Function SearchRect(Of T As IEntity)(lowerLeftCorner As Vector2, upperRightCorner As Vector2, filter As Func(Of T, Boolean), ByRef resultList As List(Of T)) As ErrorMessage
        parameters:
        - id: lowerLeftCorner
          type: Vector2
          description: World position on the X and Z coordinates representing the lower left corner of the search rect.
        - id: upperRightCorner
          type: Vector2
          description: World position on the X and Z coordinates representing the upper right corner of the search rect.
        - id: filter
          type: System.Func{{T},System.Boolean}
          description: Function that allows to filter the search result. Only entities that satisfy the filter will be returned in the results list.
        - id: resultList
          type: System.Collections.Generic.List{{T}}
          description: The search results that satisfy the filter&apos;s conditions and are in the search rect will populate this list.
        typeParameters:
        - id: T
          description: Type of the search results that extends the Entity type.
        return:
          type: RTSEngine.ErrorMessage
          description: ErrorMessage.none if the search was completed successfully, otherwise the failure&apos;s error code.
      overload: RTSEngine.Search.GridSearchHandler.SearchRect*
      modifiers:
        CSharp:
        - public
        VB:
        - Public

      namespace: RTSEngine.Search
      source:
        id: Search
        path: ''
        startLine: 20861
      summary: "\nSearches for the closest potential target that extends type Entity and satisfies a set of conditions.\n"
      example: []
      syntax:
        content:
          CSharp: >-
            public ErrorMessage Search<T>(Vector3 sourcePosition, FloatRange radius, RTSHelper.IsTargetValidDelegate IsTargetValid, bool playerCommand, out T potentialTarget, bool findClosest = true)

                where T : IEntity
          VB: Public Function Search(Of T As IEntity)(sourcePosition As Vector3, radius As FloatRange, IsTargetValid As RTSHelper.IsTargetValidDelegate, playerCommand As Boolean, ByRef potentialTarget As T, findClosest As Boolean = True) As ErrorMessage
        parameters:
        - id: sourcePosition
          type: Vector3
          description: Vector3 position that represents where the search will start from.
        - id: radius
          type: RTSEngine.FloatRange
          description: The radius of the search.
        - id: IsTargetValid
          type: RTSEngine.RTSHelper.IsTargetValidDelegate
          description: Delegate that takes an instance of the searched type and returns a RTSEngine.ErrorMessage which allows to define the search conditions.
        - id: playerCommand
          type: System.Boolean
        - id: potentialTarget
          type: '{T}'
        - id: findClosest
          type: System.Boolean
        typeParameters:
        - id: T
          description: Type of the potential target that extends the Entity type.
        return:
          type: RTSEngine.ErrorMessage
          description: ErrorMessage.none if the search was completed error-free, otherwise failure&apos;S error code.
      overload: RTSEngine.Search.GridSearchHandler.Search*
      implements:

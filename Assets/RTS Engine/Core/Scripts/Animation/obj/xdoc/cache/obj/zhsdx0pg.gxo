      commentId: M:RTSEngine.Movement.IMovementSystem.TryGetValidPosition(Vector3,System.Single,System.Int32,Vector3@)
      language: CSharp
      name:
        CSharp: TryGetValidPosition(Vector3, Single, Int32, out Vector3)
        VB: TryGetValidPosition(Vector3, Single, Int32, ByRef Vector3)
      nameWithType:
        CSharp: IMovementSystem.TryGetValidPosition(Vector3, Single, Int32, out Vector3)
        VB: IMovementSystem.TryGetValidPosition(Vector3, Single, Int32, ByRef Vector3)
      qualifiedName:
        CSharp: RTSEngine.Movement.IMovementSystem.TryGetValidPosition(Vector3, System.Single, System.Int32, out Vector3)
        VB: RTSEngine.Movement.IMovementSystem.TryGetValidPosition(Vector3, System.Single, System.Int32, ByRef Vector3)
      type: Method
      assemblies:
      - cs.temp.dll
      namespace: RTSEngine.Movement
      source:
        id: TryGetValidPosition
        path: ''
        startLine: 26192
      summary: "\nAttempt to get a valid position that can be used as a movement path destination by sampling an area.\n"
      example: []
      syntax:
        content:
          CSharp: bool TryGetValidPosition(Vector3 center, float radius, int areaMask, out Vector3 validPosition)
          VB: Function TryGetValidPosition(center As Vector3, radius As Single, areaMask As Integer, ByRef validPosition As Vector3) As Boolean
        parameters:
        - id: center
          type: Vector3
          description: Center of the area to sample.
        - id: radius
          type: System.Single
          description: Radius of the area to sample.
        - id: areaMask
          type: System.Int32
          description: Area mask of the area to sample. This is the navigation area mask and not the terrain area mask!
        - id: validPosition
          type: Vector3
          description: If a valid movement destination is found, it would be available in this parameter.
        return:
          type: System.Boolean
          description: True if there is a valid movement path destination in the area to sample. Otherwise, false.
      overload: RTSEngine.Movement.IMovementSystem.TryGetValidPosition*
      modifiers:
        CSharp: []
        VB: []

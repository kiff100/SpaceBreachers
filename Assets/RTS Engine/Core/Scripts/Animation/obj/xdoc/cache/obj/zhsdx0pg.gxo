  - id: RTSEngine.Effect.EffectObjectState
    commentId: T:RTSEngine.Effect.EffectObjectState
    language: CSharp
    name:
      CSharp: EffectObjectState
      VB: EffectObjectState
    nameWithType:
      CSharp: EffectObjectState

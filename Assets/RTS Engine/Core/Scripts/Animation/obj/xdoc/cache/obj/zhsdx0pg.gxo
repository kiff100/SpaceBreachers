    - id: RTSEngine.Movement.IMovementController.Prepare(Vector3,RTSEngine.Movement.MovementSource)
      commentId: M:RTSEngine.Movement.IMovementController.Prepare(Vector3,RTSEngine.Movement.MovementSource)
      language: CSharp
      name:
        CSharp: Prepare(Vector3, MovementSource)
        VB: Prepare(Vector3, MovementSource)
      nameWithType:
        CSharp: IMovementController.Prepare(Vector3, MovementSource)
        VB: IMovementController.Prepare(Vector3, MovementSource)
      qualifiedName:
        CSharp: RTSEngine.Movement.IMovementController.Prepare(Vector3, RTSEngine.Movement.MovementSource)
        VB: RTSEngine.Movement.IMovementController.Prepare(Vector3, RTSEngine.Movement.MovementSource)
      type: Method
      assemblies:
      - cs.temp.dll
      namespace: RTSEngine.Movement
      source:
        id: Prepare
        path: ''
        startLine: 26106
      summary: "\nAttempts to calculate a valid path for the specified destination position.\nIf the path calculation is successful, you need to call OnPathPrepared() on the IMovementComponent instance of the unit and provide the same MovementSource data as its sole parameter.\nWhile you have the option to modify the MovementSource struct when calling OnPathPrepared(), it is recommended to pass the same back.\nIf the path calculation failed, you need to call OnPathFailure() on the IMovementComponent instance of the unit.\nYou do not have to make either of those two calls directly through this method. Path calculation might take some time to finish so you can always call either of those two methods later.\nHowever, make sure that one of them is eventually called as the movement component will be expecting a response after it attempts to preapre a path for the movement.\n"
      example: []
      syntax:
        content:
          CSharp: void Prepare(Vector3 destination, MovementSource source)
          VB: Sub Prepare(destination As Vector3, source As MovementSource)
        parameters:
        - id: destination
          type: Vector3
          description: Vector3 that represents the movement&apos;s target position.
        - id: source
          type: RTSEngine.Movement.MovementSource
      overload: RTSEngine.Movement.IMovementController.Prepare*
      modifiers:
        CSharp: []
        VB: []
    - id: RTSEngine.Movement.IMovementController.Launch
      commentId: M:RTSEngine.Movement.IMovementController.Launch
      language: CSharp
      name:
        CSharp: Launch()
        VB: Launch()
      nameWithType:
        CSharp: IMovementController.Launch()
        VB: IMovementController.Launch()

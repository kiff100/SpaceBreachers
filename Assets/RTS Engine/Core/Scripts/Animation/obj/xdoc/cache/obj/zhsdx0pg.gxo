      commentId: M:RTSEngine.ResourceExtension.ResourceManager.UpdateResource(System.Int32,System.Collections.Generic.IEnumerable{RTSEngine.ResourceExtension.ResourceInput},System.Boolean)
      language: CSharp
      name:
        CSharp: UpdateResource(Int32, IEnumerable<ResourceInput>, Boolean)
        VB: UpdateResource(Int32, IEnumerable(Of ResourceInput), Boolean)
      nameWithType:
        CSharp: ResourceManager.UpdateResource(Int32, IEnumerable<ResourceInput>, Boolean)
        VB: ResourceManager.UpdateResource(Int32, IEnumerable(Of ResourceInput), Boolean)
      qualifiedName:
        CSharp: RTSEngine.ResourceExtension.ResourceManager.UpdateResource(System.Int32, System.Collections.Generic.IEnumerable<RTSEngine.ResourceExtension.ResourceInput>, System.Boolean)
        VB: RTSEngine.ResourceExtension.ResourceManager.UpdateResource(System.Int32, System.Collections.Generic.IEnumerable(Of RTSEngine.ResourceExtension.ResourceInput), System.Boolean)
      type: Method
      assemblies:
      - cs.temp.dll
      namespace: RTSEngine.ResourceExtension
      source:
        id: UpdateResource
        path: ''
        startLine: 28453
      summary: "\nAdds/removes an amount of a faction&apos;s resource. If the one of the resource types has a limited based capacity resource and there is a rest amount that can not be added due to reaching maximum capacity, it will not be reported by this method.\n"
      example: []
      syntax:
        content:
          CSharp: public void UpdateResource(int factionID, IEnumerable<ResourceInput> resourceInputArray, bool add)
          VB: Public Sub UpdateResource(factionID As Integer, resourceInputArray As IEnumerable(Of ResourceInput), add As Boolean)
        parameters:
        - id: factionID
          type: System.Int32
          description: ID of the faction whose resources will be updated.
        - id: resourceInputArray
          type: System.Collections.Generic.IEnumerable{RTSEngine.ResourceExtension.ResourceInput}
          description: Array where each element defines a resource type and the amount to add/remove.
        - id: add
          type: System.Boolean
          description: Adds the resources when true, otherwise removes the resources from the faction.
      overload: RTSEngine.ResourceExtension.ResourceManager.UpdateResource*
      implements:
      - RTSEngine.ResourceExtension.IResourceManager.UpdateResource(System.Int32,System.Collections.Generic.IEnumerable{RTSEngine.ResourceExtension.ResourceInput},System.Boolean)
      modifiers:
        CSharp:
        - public
        VB:
        - Public

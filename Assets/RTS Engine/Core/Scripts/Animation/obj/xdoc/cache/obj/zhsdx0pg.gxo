    assemblies:
    - cs.temp.dll
    namespace: RTSEngine.Effect
    source:
      id: EffectObjectState
      path: ''
      startLine: 9611
    summary: "\nRepresents the state of an effect object.\ninactive: disabled effect object which can be retrieved from the pool to be used.\nrunning: enabled effect object that can not be retrieved from the pool.\ndisabling: effect object in transition from being running to inactive. In this state, the effect object can not be retrieved from the pool.\n"
    example: []
    syntax:
      content:
        CSharp: public enum EffectObjectState
        VB: Public Enum EffectObjectState
    modifiers:

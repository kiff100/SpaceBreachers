        parameters:
        - id: taskUIAttributes
          type: System.Collections.Generic.IEnumerable{EntityComponentTaskUIAttributes}
          description: TaskUIAttributes instance that contains the information required to display the resource collection task.
        - id: disabledTaskCodes
          type: System.Collections.Generic.IEnumerable{System.String}
          description: In case the resource generation task is to be disabeld, it will be the single element of this IEnumerable.
        return:
          type: System.Boolean
          description: True if there&apos;s a resource collection task that requires to be displayed, otherwise false.
